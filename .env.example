# NUNCA pongas un PAT real en este archivo ni lo commits.
# LINKY_AZURE_PAT=

# mock | http
LINKY_AZURE_MODE=mock

# keyring (default si disponible) | env | session — nunca "file"
# LINKY_SECRET_BACKEND=session

# LINKY_DATA_DIR=

# Opcional solo para adaptador eve/chat — el CLI no lo necesita
# AI_GATEWAY_API_KEY=

# Ripor: preferido `npm run linky -- ripor login` (sesión en keyring).
# Alternativa explícita: valor del header cookie de ripor.co. NUNCA lo commitees.
# LINKY_RIPOR_COOKIE=
