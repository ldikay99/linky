{
  "name": "linky",
  "version": "0.3.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "linky": "tsx agent/lib/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:mock": "tsx scripts/demo-mock.ts",
    "demo:ripor": "tsx scripts/demo-ripor-mock.ts",
    "scan": "tsx scripts/scan-secrets.ts",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "contribute": "tsx scripts/contribute.ts",
    "mcp": "tsx agent/lib/mcp/server.ts",
    "web:install": "npm ci --prefix web",
    "web": "npm --prefix web run build && npm --prefix web start",
    "web:dev": "npm --prefix web run dev",
    "web:link": "npm --prefix web run link",
    "web:test": "npm --prefix web test",
    "docker:init": "node web/scripts/docker-init.mjs",
    "docker:up": "node web/scripts/docker-init.mjs && docker compose up -d --build",
    "docker:link": "docker compose exec linky-web npm --prefix web run link"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "@vercel/connect": "2.8.0",
    "ai": "^7.0.137",
    "eve": "^1.0.0-rc.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "description": "Linky: CLI + skills agnósticas Azure Boards + Ripor (UI), secretos fuera del repo",
  "bin": {
    "linky": "./agent/lib/cli/main.ts"
  },
  "author": "Jonathan Contreras",
  "license": "MIT",
  "optionalDependencies": {
    "playwright-core": "1.64.0"
  }
}
